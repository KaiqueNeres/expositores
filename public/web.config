<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Encaminha a API de coleta para o servidor Node (server.js), que precisa
         estar rodando na porta 3020 desta mesma máquina. Requer os módulos
         "URL Rewrite" e "Application Request Routing" (ARR), com o proxy do ARR
         habilitado (Server Proxy Settings > Enable proxy).

         {R:0} é a URL inteira, incluindo o "api/": o server.js só reconhece
         /api/status e /api/refresh. Usar {R:1} aqui recortaria o prefixo e o
         Node responderia 405 a qualquer POST fora dessas rotas.

         Se não for usar o botão "Atualizar dados", esta seção pode sair. -->
    <rewrite>
      <rules>
        <rule name="API Proxy" stopProcessing="true">
          <match url="^api/.*" />
          <action type="Rewrite" url="http://localhost:3020/{R:0}" />
        </rule>
      </rules>
    </rewrite>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- Instalações do IIS sem esses tipos configurados devolvem 404.3 para
           o JSON dos dados e para o CSV; o <remove> evita erro de duplicidade
           quando o tipo já existe no servidor. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".csv" />
      <mimeMap fileExtension=".csv" mimeType="text/csv" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />

      <!-- Os dados são atualizados periodicamente e a página é uma ferramenta
           interna: sempre buscar a versão nova evita tela com dados antigos. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
	
  </system.webServer>
</configuration>
